# Take a Luke Studio. Copy to .env.local (never commit it) and fill in.
# Required values are marked REQUIRED. Everything else is optional.

# --- Core (REQUIRED) -------------------------------------------------------------
# Postgres connection string. Locally: postgres://tals:tals@localhost:5432/tals_dev
# On Neon: the pooled connection string (host contains "-pooler") with sslmode=require.
DATABASE_URL=
# Public URL of the app, used in digest links. No trailing slash.
APP_URL=http://localhost:3000
# Login password hash. Generate with:  pnpm hash-password
APP_PASSWORD_HASH=
# Random secret, at least 32 characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=
# Shared secret for the hourly scheduler (Vercel Cron sends it automatically as a Bearer token). Min 12 chars.
CRON_SECRET=
# Protects /api/digest, which the morning routine reads. A random string; leave empty to switch the digest off.
DIGEST_TOKEN=

# --- Claude (fit scores, cover letters, the Grow advisor) ----------------------------
# Without it the app still collects and rule-scores offers. Set a spend limit in the
# Anthropic Console too; the app has its own daily and monthly caps (Settings → Claude).
ANTHROPIC_API_KEY=
# Cover letters and the advisor (default claude-opus-5-5).
AI_MODEL=
# Bulk scoring of offers (default claude-haiku-5-5).
AI_MODEL_FAST=

# --- Optional job boards with free keys: the main source of Polish offers ----------
# https://developer.adzuna.com/  (country: pl)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Integration tests only -----------------------------------------------------------
# A disposable database: the integration tests wipe it. Leave empty to skip them.
TEST_DATABASE_URL=

# --- Tuning (optional) ----------------------------------------------------------------
# Page the crawler names in its User-Agent so site owners can see who is visiting.
CRAWLER_CONTACT_URL=https://lukaszwrzal.com
# Seconds of work per scheduler tick (default 270; keep below the host's function limit).
TICK_BUDGET_SECONDS=
# Database connections per process (default 5; use 1–3 on serverless hosts).
DB_POOL_MAX=
